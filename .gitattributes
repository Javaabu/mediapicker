# Path-based git attributes
# https://www.kernel.org/pub/software/scm/git/docs/gitattributes.html

# Keep development files out of the Composer package. docs, llms.txt, dist and
# resources/boost ship with it, for apps without Vite, AI assistants and Laravel Boost.
/.gitattributes     export-ignore
/.gitignore         export-ignore
/.github            export-ignore
/.editorconfig      export-ignore
/.prettierrc.json   export-ignore
/.prettierignore    export-ignore
/eslint.config.js   export-ignore
/phpunit.xml.dist   export-ignore
/pint.json          export-ignore
/tests              export-ignore
/AGENTS.md          export-ignore
/CLAUDE.md          export-ignore
/node_modules       export-ignore
/package.json       export-ignore
/pnpm-lock.yaml     export-ignore
/tsconfig.json      export-ignore
/vite.config.ts     export-ignore
/vitest.config.ts   export-ignore
