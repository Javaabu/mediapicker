{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "vite/client", "@testing-library/jest-dom"],
    "paths": {
      "@javaabu/mediapicker": ["./resources/js"],
      "@javaabu/mediapicker/*": ["./resources/js/*"],
      "@javaabu/block-editor": ["./vendor/javaabu/block-editor/resources/js"],
      "@javaabu/block-editor/*": ["./vendor/javaabu/block-editor/resources/js/*"],
      "@javaabu/stencil": ["./vendor/javaabu/stencil/resources/js"],
      "@javaabu/stencil/*": ["./vendor/javaabu/stencil/resources/js/*"]
    }
  },
  "include": ["resources/js", "tests/js", "*.config.ts"]
}
